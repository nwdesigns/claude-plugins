<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent: desktop notices from the nwdesigns hub (macOS).
     Install: cp to ~/Library/LaunchAgents/, then launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/it.nwdesigns.context-hub-notify.plist
     Needs ~/.config/context-hub/channel-token (mode 600). Exit 0 (no token, token refused) = no restart. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>it.nwdesigns.context-hub-notify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/disconnesso/Documents/Projects/context-hub/plugins/context-hub/channel/server.mjs</string>
    <string>--notify</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>/tmp/context-hub-notify.log</string>
</dict>
</plist>
