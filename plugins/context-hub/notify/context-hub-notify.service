# systemd user unit: desktop notices from the nwdesigns hub (Linux).
# Install: cp to ~/.config/systemd/user/, then systemctl --user enable --now context-hub-notify
# Needs ~/.config/context-hub/channel-token (mode 600). Exit 0 (no token, token refused) = no restart.
[Unit]
Description=context-hub desktop notices

[Service]
ExecStart=/usr/bin/node %h/Documents/Projects/context-hub/plugins/context-hub/channel/server.mjs --notify
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
