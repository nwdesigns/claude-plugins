#!/bin/sh
# SessionStart: if the repo has a valid .hub-project, print the hub check-in as context.
# Anything else prints nothing, so repos without the file pay zero tokens.
# .hub-project is repo-controlled: accept only a regular non-symlink file of at most 65 bytes whose
# raw content is one slug plus at most one final LF. Rejected content is never echoed.
export LC_ALL=C # byte semantics for the [a-z0-9-] check in every locale
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 0
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
f="$top/.hub-project"
[ -e "$f" ] || [ -L "$f" ] || exit 0
skip() {
  echo "context-hub: .hub-project is not a plain file with one valid slug; hub check-in skipped."
  exit 0
}
{ [ -f "$f" ] && [ ! -L "$f" ]; } || skip
size=$(wc -c < "$f" | tr -d ' ')
[ "$size" -le 65 ] || skip
[ "$(tr -d '\000' < "$f" | wc -c | tr -d ' ')" -eq "$size" ] || skip # NUL bytes
slug=$(head -c 65 "$f")
case $slug in *[!a-z0-9-]* | "") skip ;; esac
# Command substitution drops trailing LFs: compare with the raw size.
if [ "$size" -ne ${#slug} ]; then
  [ "$size" -eq $((${#slug} + 1)) ] && [ "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' \n')" = 0a ] || skip
fi
[ ${#slug} -le 64 ] || skip
printf 'Hub project for this repo: %s\n\n' "$slug"
cat "$dir/checkin.md"
